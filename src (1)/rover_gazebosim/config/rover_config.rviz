
# RViz Configuration File
Visualization Manager:
  Class: "rviz::VisualizationManager"
  Displays:
    - Class: "rviz/RobotModel"
      Enabled: true
      Name: "RobotModel"
      Description: "Displays the URDF model of the robot."
    - Class: "rviz/TF"
      Enabled: true
      Name: "TF"
      Description: "Visualizes the transform frames."
    - Class: "rviz/LaserScan"
      Enabled: true
      Name: "LaserScan"
      Description: "Displays laser scan data."
      Topic: "/scan"
    - Class: "rviz/Image"
      Enabled: true
      Name: "Camera"
      Description: "Displays camera data."
      Topic: "/camera/image_raw"
    - Class: "rviz/PointCloud2"
      Enabled: true
      Name: "PointCloud"
      Description: "Displays point cloud data."
      Topic: "/points"
Global Options:
  Background Color: [0.0, 0.0, 0.0]
  Fixed Frame: "base_link"
Visualization Manager:
  Displays:
    - Name: Grid
      Class: rviz_default_plugins/Grid
      Enabled: true
      Line Style:
      Class: rviz_default_plugins/Billboards
      Plane: XY
      Cell Count: 20
      Cell Size: 1
    - Name: TF
      Class: rviz_default_plugins/TF
      Enabled: true
      Show Axes: true
    - Name: RobotModel
      Class: rviz_default_plugins/RobotModel
      Enabled: true
      Robot Description: robot_description
  Global Options:
    Fixed Frame: base_link
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  View Manager:
    Current: 
      Class: rviz_default_plugins/Orbit
    Orbit:
      Distance: 10
      Focal Point:
        - 0
        - 0
        - 0
